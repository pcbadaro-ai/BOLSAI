# Porta do servidor
PORT=3000

# Senha simples para abrir o painel (deixe vazio para não exigir). Acesse com ?t=SUASENHA
ACCESS_TOKEN=

# IA (Claude). Sem a chave, a camada de IA fica desligada e o resto funciona.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# A cada quantos minutos reavaliar cada ativo (além de quando o sinal muda)
AI_EVERY_MIN=20

# X (Twitter) API v2. Busca recente exige plano pago do X (Basic ou acima).
X_BEARER_TOKEN=

# Ações (Twelve Data, plano grátis serve). Sem a chave, só cripto.
TWELVEDATA_KEY=

# Alertas no celular via Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
